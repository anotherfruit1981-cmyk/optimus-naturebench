#!/usr/bin/env python3
"""optimus-status: time, phase, best score, families, ledger, directives, disk."""
import os
import sys

sys.path.insert(0, os.environ.get("OPTIMUS_HOME", "/opt/optimus"))
import optimus_common as oc  # noqa: E402

if __name__ == "__main__":
    for line in oc.status_lines(max_ledger=int(sys.argv[1]) if len(sys.argv) > 1 else 15):
        print(line)
    for line in oc.steering_lines():
        print(line)
    oc.mark_steered()
